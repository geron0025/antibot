{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antibot.dev/schema/keys/1",
  "title": "Список доверенных ключей сверх вшитых в бинарник",
  "type": "object",
  "required": ["format", "keys", "signed_by", "signature"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/key"}
    },
    "signed_by": {"type": "string", "maxLength": 32},
    "signature": {"type": "string"}
  },
  "$defs": {
    "key": {
      "type": "object",
      "required": ["key_id", "algo", "public", "use"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 32},
        "algo": {"const": "ed25519"},
        "public": {"type": "string"},
        "use": {"enum": ["facts", "proposals"]},
        "not_before": {"type": "string", "format": "date"}
      }
    }
  }
}
