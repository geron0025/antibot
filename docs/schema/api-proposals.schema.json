{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antibot.dev/schema/api-proposals/1",
  "title": "Предложения и советы облака для этой ноды: GET /api/v1/proposals",
  "type": "object",
  "required": ["proposals", "advice"],
  "additionalProperties": false,
  "properties": {
    "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
    "advice": {"type": "array", "items": {"$ref": "#/$defs/advice"}}
  },
  "$defs": {
    "change": {
      "description": "Ответ на принятие или отклонение через API.",
      "type": "object",
      "required": ["id", "state"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "state": {"enum": ["accepted", "rejected"]}
      }
    },

    "proposal": {
      "type": "object",
      "required": ["id", "created_at", "expires_at", "rule", "why", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/cloud_id"},
        "created_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "requires_facts_version": {"type": "integer", "minimum": 1},
        "rule": {"$ref": "#/$defs/rule"},
        "why": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },

    "advice": {
      "type": "object",
      "required": ["id", "created_at", "expires_at", "rule", "suggest", "why", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/cloud_id"},
        "created_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "rule": {"$ref": "#/$defs/rule_hash"},
        "suggest": {"enum": ["disable", "shadow", "review"]},
        "why": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence": {
          "type": "object",
          "required": ["window", "requests", "share"],
          "additionalProperties": false,
          "properties": {
            "window": {"type": "string", "maxLength": 64},
            "requests": {"type": "integer", "minimum": 0},
            "share": {"type": "number", "minimum": 0, "maximum": 1},
            "with_cookie": {"type": "integer", "minimum": 0},
            "protected": {"type": "integer", "minimum": 0}
          }
        }
      }
    },

    "rule_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},

    "cloud_id": {
      "type": "string",
      "pattern": "^cloud-[a-z0-9][a-z0-9-]{0,47}$"
    },

    "rule": {
      "type": "object",
      "required": ["id", "scope", "priority", "condition", "action"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/cloud_id"},
        "name": {"type": "string", "maxLength": 200},
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        },
        "priority": {"type": "integer", "minimum": -1000, "maximum": 1000},
        "condition": {"type": "object"},
        "action": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["block", "allow", "ratelimit"]},
            "status": {"type": "integer", "minimum": 100, "maximum": 599},
            "body": {"type": "string", "maxLength": 1000},
            "limit": {"type": "integer", "minimum": 1, "maximum": 1048576},
            "window": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "key": {"type": "string", "maxLength": 64}
          }
        }
      }
    },

    "evidence": {
      "type": "object",
      "required": ["window", "requests", "share", "would_block", "would_block_protected"],
      "additionalProperties": false,
      "properties": {
        "window": {"type": "string", "maxLength": 64},
        "requests": {"type": "integer", "minimum": 0},
        "share": {"type": "number", "minimum": 0, "maximum": 1},
        "networks": {"type": "integer", "minimum": 0},
        "addresses": {"type": "integer", "minimum": 0},
        "would_block": {"type": "integer", "minimum": 0},
        "would_block_protected": {"type": "integer", "minimum": 0}
      }
    }
  }
}
