{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antibot.dev/schema/proposal-feedback/1",
  "title": "Ответ ноды: что стало с предложениями и советами",
  "type": "object",
  "required": ["format", "node", "sent_at", "items"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": 1},
    "node": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "sent_at": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "state", "at"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^cloud-[a-z0-9][a-z0-9-]{0,47}$"},
        "state": {"enum": ["accepted", "active", "disabled", "removed", "rejected", "done"]},
        "at": {"type": "string", "format": "date-time"},
        "rule": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "reason": {"type": "string", "maxLength": 500}
      }
    }
  }
}
